using System;
public class Jugador
{
    public string nombre;
    public string rol;
    public int energia;
    public int hambre;
    public int paga;
    public int tiempo;

    public void AsignarPersonaje(string nombreElegido, string herramienta, bool haDormido)
    {
        nombre = nombreElegido;

        if (herramienta == "pistola")
        {
            rol = "guardia de pato presidencial";
            energia = 90;
            hambre = 50;
            paga = 70;
            tiempo = 60;
        }
        else if (herramienta == "diccionario")
        {
            if (haDormido)
            {
                rol = "traductor de peces";
                energia = 50;
                hambre = 90;
                paga = 40;
                tiempo = 90;
            }
            else
            {
                rol = "cuidador de plantas";
                energia = 40;
                hambre = 30;
                paga = 100;
                tiempo = 50;
            }
        }
        else if (herramienta == "alpiste")
        {
            rol = "entrenador de palomas";
            energia = 90;
            hambre = 50;
            paga = 70;
            tiempo = 60;
        }
        else
        {
            rol = "cuidador de plantas";
            energia = 40;
            hambre = 30;
            paga = 100;
            tiempo = 50;
        }
    }
}

public class Program
{
    public static void mostrarJugador(Jugador player)
    {
        Console.WriteLine($"Nombre: {player.nombre}");
        Console.WriteLine($"rol: {player.rol}");
        Console.WriteLine($"energia: {player.energia}");
        Console.WriteLine($"hambre: {player.hambre}");
        Console.WriteLine($"paga: {player.paga}");
        Console.WriteLine($"tiempo: {player.tiempo} min");
    }

    public static void Main()
    {
        Jugador jugador1 = new Jugador();
        jugador1.AsignarPersonaje("idia", "alpiste", true);
        mostrarJugador(jugador1);
    }
}
