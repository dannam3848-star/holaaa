using System;
class Jugador
{
    public string nombre;
    private string rol;
    private int energia;
    private int hambre;
    private int paga;
    public int tiempo;
		
		public void AsignarPersonaje(string nombreElegido, string herramienta, bool leGustaElTe)
    {
        nombre = nombreElegido;

        if (herramienta == "pistola")
        {
            rol = "gurdia de pato precidencial";
            energia = 90;
            hambre = 50;
            paga = 70;
            tiempo = 60;
        }
        else if (herramienta == "diccionario")
        {
            if (leGustaElTe)
            {
                rol = "traductor de peces";
                energia = 50;
                hambre = 90;
                paga = 40;
                tiempo = 90;
            }
			  if (herramienta == "alpiste")
        {
            rol = "entrenador de palomas";
            energia = 90;
            hambre = 50;
            paga = 70;
            tiempo = 60;
        }
	}
            else
            {
                rol = "cuidador de plantas";
                energia = 40;
                hambre = 30;
                paga = 100;
                tiempo = 50;
            }
        }
	}
		
public class Program
{
	public static void Main()
	{
	    Console.WriteLine($"Nombre: {nombre}");
        Console.WriteLine($"rol: {rol}");
        Console.WriteLine($"energia: {energia}");
        Console.WriteLine($"hambre: {hambre}");
        Console.WriteLine($"paga: {paga}");
        Console.WriteLine($"tiempo: {tiempo}");
		}
	
           ///por defaul

          public class Program
       {
	     public static void Main()
	   {
		Jugador jugador1 = new Jugador();
		jugador1.AsignarPersonaje("idia", "alpiste", true); 
        jugador1.MostrarPersonaje();	

	}
	}
}
